---
import source from '../lib/panel-boot.js?raw';
import table from '../data/hijri.json';
import { CITIES, DEFAULT_CITY_ID, titleCase } from '../lib/cities';
import { STRINGS, type Lang } from '../lib/i18n';
import { ZONE_LABEL } from '../lib/schedule';

/** `fill` maps an element id to a line: name, from, today, hijri or greg. Place it right after those elements. `linked`: the page honours a ?kota= link. */
const { fill, linked = false, lang = 'id' } = Astro.props as { fill: Record<string, string>; linked?: boolean; lang?: Lang };
const t = STRINGS[lang];
const city = CITIES.find((c) => c.id === DEFAULT_CITY_ID)!;
const lines = Object.values(fill);
const dates = lines.some((line) => line === 'today' || line === 'hijri' || line === 'greg');
const named = lines.some((line) => line === 'name' || line === 'from');
// Every city's name and zone, so a shared link or a saved city paints its own name before first paint.
// A page that shows only dates needs only the zones that are not the default WIB.
const cities = Object.fromEntries(
  CITIES.filter((c) => named || c.tz !== city.tz).map((c) => [c.id, [named ? titleCase(c.name) : '', c.tz]]),
);
const cfg = {
  fill,
  linked,
  def: { id: city.id, name: titleCase(city.name), tz: city.tz },
  cities,
  t: { locale: t.locale, zoneLocale: t.zoneLocale, decimal: t.decimal, hemisphere: t.hemisphere, era: t.hijri.era, fromPrefix: t.fromPlace('') },
  months: t.hijri.months,
  starts: dates ? table.starts : [],
  first: table.first,
  zones: ZONE_LABEL,
};
---

<script is:inline set:html={`${source}\npanelBoot(${JSON.stringify(cfg)});`}></script>
