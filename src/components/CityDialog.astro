---
import { CITIES, cityLabel } from '../lib/cities';
import LocateButton from './LocateButton.astro';

const { title = 'Ubah kota' } = Astro.props;
---

<dialog id="settings" aria-labelledby="settings-title">
  <form method="dialog">
    <h2 id="settings-title">{title}</h2>
    <label>
      Kota
      <input id="city" aria-describedby="city-help city-hint" list="city-list" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Ketik nama kota" />
      <datalist id="city-list">
        {CITIES.map((c) => <option value={cityLabel(c)} />)}
      </datalist>
    </label>
    <p id="city-help">Ketik nama kab/kota, lalu pilih dari daftar.</p>
    <p id="city-hint" role="status"></p>
    <LocateButton id="dlg-locate" label="Lokasi saya" />
    <slot />
    <button type="submit" id="dlg-done">Selesai</button>
  </form>
</dialog>
<p id="city-announce" class="sr-only" role="status"></p>

<style is:global>
  #settings input { font: inherit; font-size: var(--fs-md); color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: var(--r-md); padding: 0.65rem 0.75rem; width: 100%; }
  #settings input::placeholder { color: var(--muted); opacity: 1; }
  #settings input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #settings {
    width: min(24rem, calc(100% - 2rem));
    padding: 0;
    border: 0;
    border-radius: var(--r-lg);
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--scrim) 25%, transparent);
  }
  #settings::backdrop { background: color-mix(in srgb, var(--scrim) 50%, transparent); }
  #settings form { display: grid; gap: 0.75rem; padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom)); }
  #settings h2 { margin: 0; font-size: var(--fs-xl); }
  #settings label { display: grid; gap: 0.25rem; font-size: var(--fs-sm); color: var(--muted); }
  #settings p { margin: 0; font-size: var(--fs-sm); color: var(--muted); }
  /* The status stays rendered so it can speak; empty, it gives back the grid gap. */
  #settings p:empty { margin-block: -0.375rem; height: 0; }
  @media (max-width: 39.99rem) {
    #settings { width: 100%; max-width: none; margin: auto 0 0; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  }
</style>
