---
import Base from '../layouts/Base.astro';

// Ticks every 10°, longer at the cardinal points.
const TICKS = Array.from({ length: 36 }, (_, i) => i * 10);
const CARDINALS = [
  { deg: 0, label: 'U' },
  { deg: 90, label: 'T' },
  { deg: 180, label: 'S' },
  { deg: 270, label: 'B' },
];
const at = (deg: number, r: number) => {
  const a = (deg - 90) * (Math.PI / 180);
  return { x: +(120 + r * Math.cos(a)).toFixed(2), y: +(120 + r * Math.sin(a)).toFixed(2) };
};
---

<Base title="Arah Kiblat · Marbot" description="Arah kiblat dari kota atau lokasi Anda, dengan kompas di HP." tab="kiblat">
  <Fragment slot="header">
    <h1>Arah kiblat</h1>
    <p id="from">&nbsp;</p>
  </Fragment>

  <section class="hero card" id="hero" data-mode="static">
    <svg viewBox="-22 -22 284 284" aria-hidden="true">
      <g id="dial">
        <circle class="face-disc" cx="120" cy="120" r="100" />
        {
          TICKS.map((deg) => {
            const a = at(deg, 97);
            const b = at(deg, deg % 90 ? 92 : 88);
            return <line class:list={['tick', { major: !(deg % 90) }]} x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
          })
        }
        {
          CARDINALS.map(({ deg, label }) => {
            const p = at(deg, 76);
            return (
              <text class:list={['cardinal', { north: deg === 0 }]} x={p.x} y={p.y} transform={`rotate(${deg} ${p.x} ${p.y})`}>
                {label}
              </text>
            );
          })
        }
        <g id="qibla">
          <path class="needle" d="M120 50 L125.5 114 L120 120 L114.5 114 Z" />
          <g class="kaaba" transform="translate(120 6)">
            <rect x="-7" y="-7" width="14" height="14" rx="1.5" />
            <line x1="-7" y1="-2.5" x2="7" y2="-2.5" />
          </g>
        </g>
        <circle class="hub" cx="120" cy="120" r="4.5" />
      </g>
      <polygon class="pointer" points="113,-21 127,-21 120,-11" />
    </svg>
    <div class="reading">
      <p id="bearing">--°</p>
      <p id="turn">dari utara</p>
    </div>
  </section>

  <p id="hint" role="status">Memuat…</p>
  <div class="actions">
    <button type="button" id="compass" hidden>Nyalakan kompas</button>
    <button type="button" id="locate">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="2.5" class="dot" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
      Hitung dari lokasi saya
    </button>
  </div>

  <dl class="facts card">
    <div><dt>Arah</dt><dd id="fact-bearing">&nbsp;</dd></div>
    <div><dt>Jarak ke Ka'bah</dt><dd id="fact-distance">&nbsp;</dd></div>
  </dl>

  <p class="note">
    Kompas HP bisa meleset beberapa derajat di dekat logam, magnet, atau perangkat listrik. Jika arahnya melompat,
    gerakkan HP membentuk angka 8 untuk kalibrasi.
  </p>
  <noscript><p>Marbot butuh JavaScript untuk menghitung arah kiblat.</p></noscript>
</Base>

<script>
  import { cityById, DEFAULT_CITY_ID, distanceKm, titleCase } from '../lib/cities';
  import { KAABA, qiblaBearing, turnTo } from '../lib/qibla';
  import { store } from '../lib/store';

  const $ = <T extends Element>(id: string) => document.getElementById(id) as unknown as T;
  const hero = $<HTMLElement>('hero');
  const dial = $<SVGGElement>('dial');
  const ALIGNED_DEG = 3;
  const POINTS = ['utara', 'timur laut', 'timur', 'tenggara', 'selatan', 'barat daya', 'barat', 'barat laut'];

  const city = cityById(store.get('bedug:city')) ?? cityById(DEFAULT_CITY_ID)!;
  let bearing = 0;

  function setOrigin(lat: number, lon: number, from: string) {
    bearing = qiblaBearing(lat, lon);
    $('qibla').setAttribute('transform', `rotate(${bearing.toFixed(2)} 120 120)`);
    $('from').textContent = from;
    $('fact-bearing').textContent = `${bearing.toFixed(1).replace('.', ',')}° dari utara, ke ${POINTS[Math.round(bearing / 45) % 8]}`;
    $('fact-distance').textContent = `${Math.round(distanceKm(lat, lon, KAABA.lat, KAABA.lon)).toLocaleString('id-ID')} km`;
    if (hero.dataset.mode === 'static') showStatic();
  }

  function showStatic() {
    $('bearing').textContent = `${Math.round(bearing)}°`;
    $('turn').textContent = 'dari utara';
    $('hint').textContent = 'Hadapkan huruf U ke utara, lalu ikuti garis ke Ka’bah.';
  }

  // Compass. Headings are smoothed as a unit vector so 359° and 1° average to 0°, not 180°.
  // shortcut: headings are magnetic, not true north; Indonesia's declination stays within about 4°, near the alignment tolerance. Correct with a declination model if that ever matters.
  type CompassEvent = DeviceOrientationEvent & { webkitCompassHeading?: number };
  let sx = 0;
  let sy = 0;
  let shown = 0; // the dial's rotation, unwrapped so it never spins the long way round
  let aligned = false;

  function onOrientation(e: CompassEvent) {
    let heading: number | null = null;
    if (typeof e.webkitCompassHeading === 'number') heading = e.webkitCompassHeading;
    else if (e.absolute && e.alpha !== null) heading = 360 - e.alpha;
    if (heading === null) return;
    heading += screen.orientation?.angle ?? 0;

    const a = heading * (Math.PI / 180);
    const first = hero.dataset.mode === 'static';
    sx = first ? Math.cos(a) : sx * 0.8 + Math.cos(a) * 0.2;
    sy = first ? Math.sin(a) : sy * 0.8 + Math.sin(a) * 0.2;
    const smooth = (Math.atan2(sy, sx) * (180 / Math.PI) + 360) % 360;
    shown += turnTo(shown, smooth);
    dial.setAttribute('transform', `rotate(${(-shown).toFixed(2)} 120 120)`);

    const turn = turnTo(smooth, bearing);
    const nowAligned = Math.abs(turn) <= ALIGNED_DEG;
    if (nowAligned && !aligned) navigator.vibrate?.(40);
    aligned = nowAligned;
    hero.dataset.mode = aligned ? 'aligned' : 'live';
    $('bearing').textContent = aligned ? 'Kiblat' : `${Math.round(Math.abs(turn))}°`;
    $('turn').textContent = aligned ? 'sudah lurus' : turn > 0 ? 'putar ke kanan' : 'putar ke kiri';
    $('hint').textContent = aligned ? 'Bagian atas HP menghadap kiblat.' : 'Pegang HP mendatar, putar badan sampai tanda di atas bertemu Ka’bah.';
    $<HTMLButtonElement>('compass').hidden = true;
  }

  const Orientation = window.DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<PermissionState> } | undefined;
  // Not `in window`: TS's lib always declares it, so `in` would narrow the else branches to never.
  if (window.ondeviceorientationabsolute !== undefined) {
    window.addEventListener('deviceorientationabsolute', onOrientation as EventListener);
  } else if (typeof Orientation?.requestPermission === 'function') {
    // iOS asks for permission, and only from a tap.
    $<HTMLButtonElement>('compass').hidden = false;
    $('compass').addEventListener('click', async () => {
      const answer = await Orientation.requestPermission!().catch(() => 'denied');
      if (answer === 'granted') window.addEventListener('deviceorientation', onOrientation as EventListener);
      else $('hint').textContent = 'Izin kompas ditolak. Hadapkan huruf U ke utara, lalu ikuti garis ke Ka’bah.';
    });
  } else if (Orientation) {
    window.addEventListener('deviceorientation', onOrientation as EventListener);
  }

  $('locate').addEventListener('click', () => {
    if (!('geolocation' in navigator)) return void ($('hint').textContent = 'Browser ini tidak mendukung lokasi.');
    $('hint').textContent = 'Mencari lokasi…';
    navigator.geolocation.getCurrentPosition(
      ({ coords }) => {
        setOrigin(coords.latitude, coords.longitude, `dari lokasi Anda (±${Math.round(coords.accuracy)} m)`);
      },
      (e) => {
        const why = { 1: 'Izin lokasi ditolak', 2: 'Lokasi tidak ditemukan', 3: 'Lokasi terlalu lama dicari' }[e.code] ?? 'Lokasi tidak tersedia';
        $('hint').textContent = `${why}. Arah tetap dihitung dari ${titleCase(city.name)}.`;
      },
      { enableHighAccuracy: true, timeout: 15_000 },
    );
  });

  setOrigin(city.lat, city.lon, `dari ${titleCase(city.name)}`);
</script>

<style>
  #from { margin-top: 0.35rem; color: var(--on-panel-muted); font-size: var(--fs-sm); }
  .hero { padding: 1.5rem 1.25rem 1.25rem; text-align: center; transition: background-color 250ms ease-out; }
  .hero svg { display: block; width: min(100%, 19rem); margin: 0 auto; }
  .face-disc { fill: var(--bg); stroke: var(--line); stroke-width: 1; transition: fill 250ms ease-out; }
  .tick { stroke: var(--muted); stroke-width: 1.5; stroke-linecap: round; opacity: 0.55; }
  .tick.major { stroke: var(--ink); stroke-width: 2.5; opacity: 1; }
  .cardinal { fill: var(--muted); font-size: 15px; font-weight: 600; text-anchor: middle; dominant-baseline: central; }
  .cardinal.north { fill: var(--ink); }
  .needle { fill: var(--accent); }
  .hub { fill: var(--card); stroke: var(--accent); stroke-width: 2.5; }
  .kaaba rect { fill: #121614; }
  .kaaba line { stroke: var(--gold); stroke-width: 2; }
  @media (prefers-color-scheme: dark) { .kaaba rect { stroke: var(--muted); stroke-width: 1; } }
  .pointer { fill: var(--gold); visibility: hidden; }
  [data-mode='live'] .pointer, [data-mode='aligned'] .pointer { visibility: visible; }
  [data-mode='aligned'] .face-disc { fill: var(--accent-soft); }

  .reading { margin-top: 0.75rem; }
  .reading p { margin: 0; }
  #bearing { font-size: var(--fs-display-sm); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  [data-mode='aligned'] #bearing { color: var(--accent); font-weight: 600; }
  #turn { color: var(--muted); }

  #hint { margin: 1rem 0.25rem; color: var(--muted); font-size: var(--fs-sm); text-wrap: pretty; min-height: 2.7em; }
  .actions { display: grid; gap: 0.75rem; }
  #locate { display: flex; justify-content: center; align-items: center; gap: 0.4rem; }
  #locate svg { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  #locate .dot { fill: currentColor; stroke: none; }

  .facts { margin: 1.5rem 0 0; padding: 0 1rem; }
  .facts div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; }
  .facts div + div { border-top: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
</style>
