---
import Base from '../layouts/Base.astro';
import CityDialog from '../components/CityDialog.astro';
import LocateButton from '../components/LocateButton.astro';

// Ticks every 10°, longer at the cardinal points.
const TICKS = Array.from({ length: 36 }, (_, i) => i * 10);
const CARDINALS = [
  { deg: 0, label: 'U' },
  { deg: 90, label: 'T' },
  { deg: 180, label: 'S' },
  { deg: 270, label: 'B' },
];
const at = (deg: number, r: number) => {
  const a = (deg - 90) * (Math.PI / 180);
  return { x: +(120 + r * Math.cos(a)).toFixed(2), y: +(120 + r * Math.sin(a)).toFixed(2) };
};
---

<Base title="Arah Kiblat · Marbot" description="Arah kiblat dari kota atau lokasi Anda, dengan kompas di HP." tab="kiblat">
  <Fragment slot="header">
    <h1>Arah kiblat</h1>
    <div class="place">
      <p id="from">&nbsp;</p>
      <button type="button" class="pill" data-open-city aria-label="Ubah kota">Ubah</button>
    </div>
  </Fragment>

  <section class="hero card" id="hero" data-mode="static">
    <svg viewBox="-22 -22 284 284" aria-hidden="true">
      <g id="dial">
        <circle class="face-disc" cx="120" cy="120" r="100" />
        {
          TICKS.map((deg) => {
            const a = at(deg, 97);
            const b = at(deg, deg % 90 ? 92 : 88);
            return <line class:list={['tick', { major: !(deg % 90) }]} x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
          })
        }
        {
          CARDINALS.map(({ deg, label }) => {
            const p = at(deg, 76);
            return (
              <text font-size="15" class:list={['cardinal', { north: deg === 0 }]} x={p.x} y={p.y}>
                {label}
              </text>
            );
          })
        }
        <g id="qibla">
          <path class="needle" d="M120 50 L125.5 114 L120 120 L114.5 114 Z" />
          <g class="kaaba" transform="translate(120 6)">
            <rect x="-7" y="-7" width="14" height="14" rx="1.5" />
            <line x1="-7" y1="-2.5" x2="7" y2="-2.5" />
          </g>
        </g>
        <circle class="hub" cx="120" cy="120" r="4.5" />
      </g>
      <polygon class="pointer" points="113,-21 127,-21 120,-11" />
    </svg>
    <div class="reading">
      <p id="bearing">--°</p>
      <p id="turn">dari utara</p>
    </div>
  </section>

  <p id="hint" role="status">Memuat…</p>
  <p id="north-tip">Tidak tahu arah utara? Matahari terbit di timur.</p>
  <p id="announce" class="sr-only" aria-live="polite"></p>
  <div class="actions">
    <button type="button" id="compass" hidden>Nyalakan kompas</button>
    <LocateButton id="locate" label="Hitung dari lokasi saya" />
  </div>

  <dl class="facts card">
    <div><dt>Arah</dt><dd id="fact-bearing">&nbsp;</dd></div>
    <div><dt>Jarak ke Ka'bah</dt><dd id="fact-distance">&nbsp;</dd></div>
  </dl>

  <p class="note">
    Kompas HP bisa meleset beberapa derajat di dekat logam, magnet, atau perangkat listrik. Jika arahnya melompat,
    gerakkan HP membentuk angka 8 untuk kalibrasi.
  </p>
  <noscript><p>Marbot butuh JavaScript untuk menghitung arah kiblat.</p></noscript>
  <CityDialog />
</Base>

<script>
  import { cityById, DEFAULT_CITY_ID, distanceKm, titleCase, type City } from '../lib/cities';
  import { announceTurn, KAABA, qiblaBearing, turnTo, type Said } from '../lib/qibla';
  import { store, storeKey } from '../lib/store';
  import { $, setText } from '../lib/dom';
  import { geoReason } from '../lib/geo';
  import { initCityDialog } from '../lib/city-dialog';

  const hero = $<HTMLElement>('hero');
  const dial = $<SVGGElement>('dial');
  const cardinals = [...document.querySelectorAll('.cardinal')];
  const ALIGNED_DEG = 3;
  const POINTS = ['utara', 'timur laut', 'timur', 'tenggara', 'selatan', 'barat daya', 'barat', 'barat laut'];

  let city = cityById(store.get(storeKey('city'))) ?? cityById(DEFAULT_CITY_ID)!;
  let bearing = 0;
  let noCompass = false; // a compass listener is on, but no heading arrived
  let waitTimer: number | undefined;
  let msg = ''; // a one-off message (searching, an error) that takes the hint's place until the next one

  /** Shows a message in the hint. Once the compass is live the hint no longer speaks, so #announce does: one voice per message. */
  function say(text: string) {
    msg = text;
    setText('hint', text);
    if (!$('hint').hasAttribute('role')) $('announce').textContent = text;
  }

  function setOrigin(lat: number, lon: number, from: string) {
    bearing = qiblaBearing(lat, lon);
    msg = '';
    $('qibla').setAttribute('transform', `rotate(${bearing.toFixed(2)} 120 120)`);
    $('from').textContent = from;
    $('fact-bearing').textContent = `${bearing.toFixed(1).replace('.', ',')}° dari utara, ke ${POINTS[Math.round(bearing / 45) % 8]}`;
    $('fact-distance').textContent = `${Math.round(distanceKm(lat, lon, KAABA.lat, KAABA.lon)).toLocaleString('id-ID')} km`;
    if (hero.dataset.mode === 'static') showStatic();
  }

  function showStatic() {
    setText('bearing', `${Math.round(bearing)}°`);
    setText('turn', 'dari utara');
    setText('hint', msg || (noCompass
      ? `Perangkat ini tidak punya kompas; pakai arah ${Math.round(bearing)}° dari utara.`
      : 'Hadapkan huruf U ke utara, lalu ikuti garis ke Ka’bah.'));
  }

  // Compass. Headings are smoothed as a unit vector so 359° and 1° average to 0°, not 180°.
  // shortcut: headings are magnetic, not true north; Indonesia's declination stays within about 4°, near the alignment tolerance. Correct with a declination model if that ever matters.
  type CompassEvent = DeviceOrientationEvent & { webkitCompassHeading?: number };
  let sx = 0;
  let sy = 0;
  let shown = 0; // the dial's rotation, unwrapped so it never spins the long way round
  let aligned = false;

  let haveHeading = false;
  let said: Said | null = null;
  let frame = 0;

  function onOrientation(e: CompassEvent) {
    let heading: number | null = null;
    if (typeof e.webkitCompassHeading === 'number') heading = e.webkitCompassHeading;
    else if (e.absolute && e.alpha !== null) heading = 360 - e.alpha;
    if (heading === null) return;
    clearTimeout(waitTimer);
    noCompass = false;
    heading += screen.orientation?.angle ?? 0;

    const a = heading * (Math.PI / 180);
    sx = haveHeading ? sx * 0.8 + Math.cos(a) * 0.2 : Math.cos(a);
    sy = haveHeading ? sy * 0.8 + Math.sin(a) * 0.2 : Math.sin(a);
    haveHeading = true;
    frame ||= requestAnimationFrame(render); // events outrun the screen; draw the latest once per frame
  }

  function render() {
    frame = 0;
    const smooth = (Math.atan2(sy, sx) * (180 / Math.PI) + 360) % 360;
    shown += turnTo(shown, smooth);
    dial.setAttribute('transform', `rotate(${(-shown).toFixed(2)} 120 120)`);
    // Letters stay upright while the dial turns.
    for (const t of cardinals) t.setAttribute('transform', `rotate(${shown.toFixed(2)} ${t.getAttribute('x')} ${t.getAttribute('y')})`);
    // From here #announce is the one live voice; the hint would repeat it.
    $('hint').removeAttribute('role');

    const turn = turnTo(smooth, bearing);
    const nowAligned = Math.abs(turn) <= ALIGNED_DEG;
    if (nowAligned && !aligned) navigator.vibrate?.(40);
    aligned = nowAligned;
    hero.dataset.mode = aligned ? 'aligned' : 'live';
    setText('bearing', aligned ? 'Kiblat' : `${Math.round(Math.abs(turn))}°`);
    setText('turn', aligned ? 'sudah lurus' : turn > 0 ? 'putar ke kanan' : 'putar ke kiri');
    setText('hint', msg || (aligned ? 'Bagian atas HP menghadap kiblat.' : 'Pegang HP mendatar, putar badan sampai tanda di atas bertemu Ka’bah.'));
    $<HTMLButtonElement>('compass').hidden = true;

    const spoken = announceTurn(said, turn, aligned, Date.now());
    said = spoken.next;
    if (spoken.say) $('announce').textContent = spoken.say;
  }

  // Some desktops expose the event but never fire it with a heading; say so after a few seconds.
  function listen(type: string) {
    window.addEventListener(type, onOrientation as EventListener);
    waitTimer = window.setTimeout(() => {
      noCompass = true;
      if (hero.dataset.mode === 'static') showStatic();
    }, 3000);
  }

  const Orientation = window.DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<PermissionState> } | undefined;
  // Not `in window`: TS's lib always declares it, so `in` would narrow the else branches to never.
  if (window.ondeviceorientationabsolute !== undefined) {
    listen('deviceorientationabsolute');
  } else if (typeof Orientation?.requestPermission === 'function') {
    // iOS asks for permission, and only from a tap.
    $<HTMLButtonElement>('compass').hidden = false;
    $('compass').addEventListener('click', async () => {
      const answer = await Orientation.requestPermission!().catch(() => 'denied');
      if (answer === 'granted') listen('deviceorientation');
      else say('Izin kompas ditolak. Hadapkan huruf U ke utara, lalu ikuti garis ke Ka’bah.');
    });
  } else if (Orientation) {
    listen('deviceorientation');
  }

  // The secondary button is "Hitung dari lokasi saya"; after a location fix it becomes the way back.
  let undo: { label: string; run: () => void } | null = null;
  function setUndo(to: typeof undo) {
    undo = to;
    $('locate').querySelector('span')!.textContent = to?.label ?? 'Hitung dari lokasi saya';
  }
  function useCity() {
    setOrigin(city.lat, city.lon, `dari ${titleCase(city.name)}`);
    setUndo(null);
  }
  const backTo = (name: string) => `Kembali ke ${titleCase(name)}`;

  $('locate').addEventListener('click', () => {
    if (undo) return undo.run();
    if (!('geolocation' in navigator)) return say('Browser ini tidak mendukung lokasi.');
    say('Mencari lokasi…');
    navigator.geolocation.getCurrentPosition(
      ({ coords }) => {
        setOrigin(coords.latitude, coords.longitude, `dari lokasi Anda (±${Math.round(coords.accuracy)} m)`);
        setUndo({ label: backTo(city.name), run: useCity });
      },
      (e) => {
        say(`${geoReason(e.code)}. Arah tetap dihitung dari ${titleCase(city.name)}.`);
      },
      { enableHighAccuracy: true, timeout: 15_000 },
    );
  });

  useCity();

  function pickCity(c: City, back?: City) {
    city = c;
    // The bearing needs only coordinates, so it works offline; saving the city is for Jadwal, which needs the network.
    if (navigator.onLine) store.set(storeKey('city'), c.id);
    useCity();
    // A location fix replaced the city: the same button goes back to it.
    if (back) setUndo({ label: backTo(back.name), run: () => pickCity(back) });
  }
  initCityDialog({ current: () => city, pick: (c, _note, back) => pickCity(c, back) });
</script>

<style>
  #from { margin: 0; color: var(--on-panel-muted); font-size: var(--fs-sm); }
  .hero { padding: 1.5rem 1.25rem 1.25rem; text-align: center; transition: background-color 250ms ease-out; }
  .hero svg { display: block; width: min(100%, 19rem); margin: 0 auto; }
  @media (min-width: 60rem) { .hero svg { width: min(100%, 26rem); } }
  .face-disc { fill: var(--bg); stroke: var(--line); stroke-width: 1; transition: fill 250ms ease-out; }
  .tick { stroke: var(--muted); stroke-width: 1.5; stroke-linecap: round; opacity: 0.55; }
  .tick.major { stroke: var(--ink); stroke-width: 2.5; opacity: 1; }
  .cardinal { fill: var(--muted); font-weight: 600; text-anchor: middle; dominant-baseline: central; }
  .cardinal.north { fill: var(--ink); }
  .needle { fill: var(--accent); }
  .hub { fill: var(--card); stroke: var(--accent); stroke-width: 2.5; }
  .kaaba rect { fill: var(--kaaba); }
  .kaaba line { stroke: var(--gold); stroke-width: 2; }
  @media (prefers-color-scheme: dark) { .kaaba rect { stroke: var(--muted); stroke-width: 1; } }
  .pointer { fill: var(--gold); visibility: hidden; }
  [data-mode='live'] .pointer, [data-mode='aligned'] .pointer { visibility: visible; }
  [data-mode='aligned'] .face-disc { fill: var(--accent-soft); }

  .reading { margin-top: 0.75rem; }
  .reading p { margin: 0; }
  #bearing { font-size: min(var(--fs-display-sm), 12vw); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  [data-mode='aligned'] #bearing { color: var(--accent); font-weight: 600; }
  #turn { color: var(--muted); }

  #north-tip { margin: -0.5rem 0.25rem 1rem; color: var(--muted); font-size: var(--fs-sm); }
  .hero:not([data-mode='static']) ~ #north-tip { display: none; } /* a live compass needs no tip */
  #hint { margin: 1rem 0.25rem; color: var(--muted); font-size: var(--fs-sm); text-wrap: pretty; min-height: 3em; }
  .actions { display: grid; gap: 0.75rem; }

  .facts { margin: 1.5rem 0 0; padding: 0 1rem; }
  .facts div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; }
  .facts div + div { border-top: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { flex: 1; margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
</style>
