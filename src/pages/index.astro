---
import { CITIES, DEFAULT_CITY_ID, titleCase } from '../lib/cities';
import { PRAYERS, capitalise, TIMES } from '../lib/schedule';
import { SOURCES } from '../lib/sources';
import Base from '../layouts/Base.astro';
import CityDialog from '../components/CityDialog.astro';
import PanelBoot from '../components/PanelBoot.astro';

---

<Base title="Jadwal Sholat · Marbot" description="Jadwal sholat hari ini dan hitung mundur ke waktu sholat berikutnya." tab="jadwal">
    <Fragment slot="header">
      <div class="place">
        <h1 id="city-name" tabindex="-1">{titleCase(CITIES.find((c) => c.id === DEFAULT_CITY_ID)!.name)}</h1>
        <button type="button" class="pill" data-open-city aria-label="Ubah kota">Ubah</button>
      </div>
      <p id="today">&nbsp;</p>
      <p id="hijri">&nbsp;</p>
      <section class="hero" id="hero" data-state="loading" aria-live="polite" aria-atomic="true">
        <p id="next-name">…</p>
        <p id="countdown" role="timer" aria-live="off"><span id="cd-left">‒‒:‒‒:‒‒</span><span id="cd-lagi"> lagi</span></p>
        <p id="next-at">besok pukul ‒‒:‒‒ WIB</p>
      </section>
      <PanelBoot linked fill={{ 'city-name': 'name', today: 'today', hijri: 'hijri' }} />
    </Fragment>

    <h2 id="list-title" class="section-title">Jadwal hari ini</h2>
    <ol id="times" class="card" aria-labelledby="list-title">
      {
        TIMES.map((t) => (
          <li data-time={t} class:list={{ minor: !(PRAYERS as readonly string[]).includes(t) }}>
            <span>{capitalise(t)}</span>
            <time>‒‒:‒‒</time>
          </li>
        ))
      }
    </ol>

    <p id="status" role="status"><span id="status-line" hidden><span id="status-text" tabindex="-1"></span> <button type="button" id="status-action" hidden></button></span></p>

    <p id="source-note">&nbsp;</p>

    <CityDialog title="Kota & sumber jadwal">
      <label>
        Sumber
        <select id="source">
          {Object.values(SOURCES).map((s) => <option value={s.id}>{s.label}</option>)}
        </select>
      </label>
    </CityDialog>

    <noscript><p>Marbot butuh JavaScript untuk menampilkan jadwal.</p></noscript>

  <script>
    import { cityById, DEFAULT_CITY_ID, offerLinked, titleCase, type City } from '../lib/cities';
    import {
      cityClock, cityDate, formatCountdown, lastPrayer, mergeMonths, nextPrayer, parseCachedMonth, capitalise, daysWhileLoading, toInstant, ZONE_IANA, ZONE_LABEL, type DaySchedule, type TimeName, type UtcOffset,
    } from '../lib/schedule';
    import { formatHijri, toHijri } from '../lib/hijri';
    import { SOURCES, type Source, type SourceId } from '../lib/sources';
    import { $, setText } from '../lib/dom';
    import { saveCity, savedCity, store, storeKey } from '../lib/store';
    import { initCityDialog, locatedChange, locateNearest } from '../lib/city-dialog';

    const sourceSelect = $<HTMLSelectElement>('source');

    // A shared link (?kota=<id>) is shown for this view and never stored unasked.
    const linked = cityById(new URLSearchParams(location.search).get('kota'));
    const stored = savedCity();
    let city: City = linked ?? stored ?? cityById(DEFAULT_CITY_ID)!;
    let toSave: string | null = null; // a picked city is stored only once its schedule has loaded
    let chosen = !!stored || !!linked; // until then, offer geolocation
    let cityNote = ''; // e.g. a distance warning after locating; kept until the city changes
    let cityAction: { label: string; run: () => void } | undefined;
    if (linked && offerLinked(linked, stored)) {
      cityNote = `Jadwal ${titleCase(linked.name)} dari tautan.`;
      cityAction = {
        label: 'Simpan sebagai kota saya',
        run: () => {
          saveCity(linked);
          cityNote = `${titleCase(linked.name)} disimpan sebagai kota Anda.`; // stays until the next city change
          cityAction = undefined;
          quietStatus();
        },
      };
    }
    let preferred: SourceId = store.get(storeKey('source')) === 'aladhan' ? 'aladhan' : 'myquran';
    let days: DaySchedule[] = [];
    let loadedFor = ''; // `${cityId}:${cityDate}` the current `days` were loaded for
    let loadToken = 0;
    let loadFailed = false;
    let partial = false; // today loaded, but yesterday's or tomorrow's month is missing


    /** The digits, plus the word that makes them "left" rather than a clock time. */
    const setCountdown = (text: string, remaining = false) => {
      setText('cd-left', text);
      $('cd-lagi').hidden = !remaining;
    };

    let statusAction: (() => void) | null = null;
    function setStatus(text: string, action?: { label: string; run: () => void }) {
      const button = $<HTMLButtonElement>('status-action');
      const hadFocus = document.activeElement === button;
      setText('status-text', text);
      $('status-line').hidden = !text;
      button.hidden = !action;
      button.textContent = action?.label ?? '';
      statusAction = action?.run ?? null;
      // A focused button that disappears would drop focus to the page; keep it nearby.
      if (hadFocus && !action) $(text ? 'status-text' : 'city-name').focus();
    }

    /** Why a source failed, in words a reader can act on. */
    function describeError(e: unknown): string {
      if (e instanceof DOMException && e.name === 'TimeoutError') return 'server tidak menjawab';
      if (e instanceof TypeError) return navigator.onLine ? 'server tidak bisa dihubungi' : 'tidak ada koneksi internet';
      const status = /^HTTP (\d+)/.exec((e as Error).message)?.[1];
      return status ? `server bermasalah (${status})` : 'data jadwal tidak valid';
    }

    // AbortSignal.timeout is missing on iOS 15, so time out by hand; describeError keys on the name.
    async function fetchWithTimeout(url: string, ms = 10_000) {
      const ctl = new AbortController();
      let timedOut = false;
      const timer = setTimeout(() => { timedOut = true; ctl.abort(); }, ms);
      try {
        return await fetch(url, { signal: ctl.signal });
      } catch (e) {
        throw timedOut ? new DOMException('timeout', 'TimeoutError') : e;
      } finally {
        clearTimeout(timer);
      }
    }

    const DAY_MS = 86_400_000;
    const refetching = new Set<string>();

    async function fetchMonth(source: Source, c: City, ym: string, key: string): Promise<DaySchedule[]> {
      const [y, m] = ym.split('-').map(Number);
      const res = await fetchWithTimeout(source.url(c, y, m));
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const month = source.parse(await res.json());
      store.set(key, JSON.stringify({ fetched: Date.now(), days: month }));
      return month;
    }

    // Cache first; a cached month older than a day is refetched quietly and used from the next load on.
    async function loadMonth(c: City, ym: string): Promise<{ source: Source; days: DaySchedule[] }> {
      const order = [SOURCES[preferred], ...Object.values(SOURCES).filter((s) => s.id !== preferred)];
      let firstError: unknown;
      for (const source of order) {
        const key = storeKey(source.id, c.id, ym);
        try {
          const raw = store.get(key);
          if (raw) {
            const cached = parseCachedMonth(raw);
            if (navigator.onLine && Date.now() - cached.fetched > DAY_MS && !refetching.has(key)) {
              refetching.add(key);
              fetchMonth(source, c, ym, key).catch(() => {}).finally(() => refetching.delete(key));
            }
            return { source, days: cached.days };
          }
          return { source, days: await fetchMonth(source, c, ym, key) };
        } catch (e) {
          firstError ??= e;
        }
      }
      throw firstError;
    }

    async function refresh() {
      const token = ++loadToken;
      const now = Date.now();
      // Yesterday for the prayer before Subuh, tomorrow for the one after Isya.
      const wanted = [-1, 0, 1].map((d) => cityDate(now, city.utcOffset, d));
      loadedFor = `${city.id}:${wanted[1]}`;
      loadFailed = false;
      partial = false;
      const months = [...new Set(wanted.map((d) => d.slice(0, 7)))];
      const merged = mergeMonths(wanted, wanted[1], months, await Promise.allSettled(months.map((ym) => loadMonth(city, ym))));
      if (token !== loadToken) return; // a newer city/source choice won
      if (merged.ok) {
        days = merged.days;
        partial = merged.partial;
        if (toSave === city.id) saveCity(city);
        toSave = null;
        const used = merged.today.source;
        setText('source-note', `Sumber: ${used.credit}`);
        if (used.id === preferred) quietStatus();
        else setStatus(`${SOURCES[preferred].name} tidak bisa dipakai, jadwal dari ${used.name}.`);
        // Online now: save next month too, so the last day of a month still works offline.
        const [y, m] = wanted[1].split('-').map(Number);
        const nextMonth = new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 7);
        if (navigator.onLine && !months.includes(nextMonth)) loadMonth(city, nextMonth).catch(() => {});
      } else {
        days = [];
        setText('source-note', '\u00a0');
        loadFailed = true;
        const saved = savedCity();
        if (!navigator.onLine && saved && saved.id !== city.id) {
          const heldNow = left;
          setStatus(`Jadwal ${titleCase(city.name)} belum tersimpan. Sambungkan internet sekali.`, {
            label: `Kembali ke ${titleCase(saved.name)}`,
            run: () => setCity(saved, '', undefined, heldNow),
          });
        } else setStatus(`${capitalise(describeError(merged.error))}. Dicoba lagi tiap menit.`, { label: 'Coba lagi', run: refresh });
        setTimeout(() => token === loadToken && refresh(), 60_000);
      }
      tick();
    }

    const SOON_MS = 10 * 60_000;
    const ARRIVED_MS = 10 * 60_000;
    const dateFormats: Partial<Record<UtcOffset, Intl.DateTimeFormat>> = {};
    const dateFormat = (offset: UtcOffset) =>
      (dateFormats[offset] ??= new Intl.DateTimeFormat('id-ID', { dateStyle: 'full', timeZone: ZONE_IANA[offset] }));

    function tick() {
      const now = Date.now();
      const zone = ZONE_LABEL[city.utcOffset];
      const today = cityDate(now, city.utcOffset);
      if (loadedFor !== `${city.id}:${today}`) return void refresh(); // city midnight passed

      setText('today', `${dateFormat(city.utcOffset).format(now)} · ${cityClock(now, city.utcOffset)} ${zone}`);
      const hijri = toHijri(today);
      setText('hijri', hijri ? formatHijri(hijri) : '\u00a0');

      const next = nextPrayer(days, now, city.utcOffset);
      const last = lastPrayer(days, now, city.utcOffset);
      // A prayer stays "arrived" for a while; before that, the last minutes count down in accent.
      const arrived = last && now - last.at < ARRIVED_MS ? last : null;
      const shown = arrived ?? next;
      $('hero').dataset.state =
        !next ? (loadFailed || partial ? 'error' : 'loading') : arrived ? 'now' : next.at - now <= SOON_MS ? 'soon' : 'count';

      // After Isya the next prayer is tomorrow's Subuh, so show tomorrow's list.
      const listDate = shown?.date ?? today;
      const listed = days.find((d) => d.date === listDate);
      setText('list-title', listDate === today ? 'Jadwal hari ini' : 'Jadwal besok');
      for (const li of document.querySelectorAll<HTMLLIElement>('#times li')) {
        const t = li.dataset.time as TimeName;
        const cell = li.querySelector('time')!;
        const hhmm = listed?.[t] ?? '‒‒:‒‒';
        const iso = listed ? `${listDate}T${hhmm}` : '';
        if (cell.textContent !== hhmm || (cell.getAttribute('datetime') ?? '') !== iso) {
          cell.textContent = hhmm;
          if (iso) cell.setAttribute('datetime', iso);
          else cell.removeAttribute('datetime');
        }
        const current = shown?.name === t;
        li.classList.toggle('next', current);
        if (current) li.setAttribute('aria-current', 'time');
        else li.removeAttribute('aria-current');
        li.classList.toggle('past', !!listed && toInstant(listDate, listed[t], city.utcOffset) <= now);
      }

      if (arrived) {
        setText('next-name', capitalise(arrived.name));
        setCountdown('Sudah masuk');
        setText('next-at', `sejak ${arrived.time} ${zone}`);
        document.title = `${capitalise(arrived.name)} sudah masuk · Marbot`;
        return;
      }
      if (!next) {
        setText('next-name', '…');
        setCountdown('‒‒:‒‒:‒‒', true);
        setText('next-at', loadFailed ? 'Jadwal belum bisa dimuat' : partial ? 'Jadwal bulan depan belum tersimpan.' : 'besok pukul ‒‒:‒‒ WIB');
        document.title = 'Jadwal Sholat · Marbot';
        return;
      }
      const left = formatCountdown(next.at - now);
      setText('next-name', capitalise(next.name));
      setCountdown(left, true);
      setText('next-at', `${next.date === today ? 'pukul' : 'besok pukul'} ${next.time} ${zone}`);
      document.title = `${left} · ${capitalise(next.name)} · Marbot`;
    }

    /** The status when nothing went wrong. */
    function quietStatus() {
      if (cityNote) setStatus(cityNote, cityAction);
      else if (!chosen) setStatus(`Jadwal untuk ${titleCase(city.name)}.`, { label: 'Pakai lokasi saya', run: locate });
      else setStatus('');
    }

    /** The days held for the city we just left: a way back shows them at once; any other city shows loading, never these. */
    let left: { cityId: string; days: DaySchedule[] } = { cityId: '', days: [] };

    function setCity(c: City, note = '', back?: City, held?: typeof left) {
      left = { cityId: city.id, days };
      days = daysWhileLoading(held, c.id);
      city = c;
      chosen = true;
      cityNote = note;
      const heldNow = left;
      cityAction = back && { label: `Kembali ke ${titleCase(back.name)}`, run: () => setCity(back, '', undefined, heldNow) };
      $('city-name').textContent = titleCase(c.name);
      toSave = c.id;
      history.replaceState(null, '', `?kota=${c.id}`);
      quietStatus();
      refresh(); // sets loadedFor, so the tick below paints the loading state
      tick();
    }

    function locate() {
      setStatus('Mencari lokasi…');
      locateNearest().then(
        ({ city: c, km }) => {
          const { note, back } = locatedChange(city, c, km);
          setCity(c, note, back);
        },
        (e: Error) => setStatus(`${e.message}. Jadwal tetap untuk ${titleCase(city.name)}.`, { label: 'Pilih kota', run: cityDialog.open }),
      );
    }

    const cityDialog = initCityDialog({ current: () => city, pick: setCity });
    sourceSelect.addEventListener('change', () => {
      preferred = sourceSelect.value as SourceId;
      store.set(storeKey('source'), preferred);
      refresh();
    });
    addEventListener('online', () => (loadFailed || partial) && refresh());
    $('status-action').addEventListener('click', () => statusAction?.());

    $('city-name').textContent = titleCase(city.name);
    sourceSelect.value = preferred;
    refresh();
    setInterval(tick, 1000);
  </script>

  <style is:global>
    #today, #hijri { color: var(--on-panel-muted); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
    #today { margin-top: 0.35rem; }
    .hero { margin-top: 1.75rem; }
    #next-name { font-size: var(--fs-xl); font-weight: 600; }
    #countdown {
      font-size: min(var(--fs-display), 19vw); /* big text settings must not push it off a phone */
      font-weight: 300;
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
    #cd-lagi { font-size: var(--fs-md); font-weight: 400; letter-spacing: 0; color: var(--on-panel-muted); }
    #next-at { color: var(--on-panel-muted); font-variant-numeric: tabular-nums; }
    [data-state='soon'] #countdown { font-weight: 600; }
    [data-state='soon'] #next-at { color: var(--on-panel); }
    [data-state='now'] #countdown { font-size: min(var(--fs-display-sm), 12vw); font-weight: 400; }
    #times { list-style: none; margin: 0; padding: 0.35rem; }
    #times li {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 1rem;
      padding: 0.8rem 0.9rem 0.8rem 1.6rem;
      font-size: var(--fs-lg);
      font-variant-numeric: tabular-nums;
    }
    #times li + li { box-shadow: 0 -1px 0 var(--line); }
    #times li.minor { font-size: var(--fs-md); color: var(--muted); }
    #times li.past { color: var(--faint); }
    #times li.next { background: var(--accent-soft); color: var(--accent); font-weight: 600; border-radius: var(--r-sm); box-shadow: none; }
    #times li.next + li { box-shadow: none; }
    #times li.next::before {
      content: '';
      position: absolute;
      left: 0.7rem;
      top: 50%;
      width: 0.4rem;
      height: 0.4rem;
      margin-top: -0.2rem;
      border-radius: 50%;
      background: var(--gold);
    }
    #list-title { margin-top: 0; }
    #source-note { margin: 0.25rem 0.25rem 0; color: var(--muted); font-size: var(--fs-sm); }
    #status { margin: 0.75rem 0.25rem 0; min-height: 3em; color: var(--muted); font-size: var(--fs-sm); }
    @media (min-width: 60rem) { #status { min-height: 1.5em; } } /* the column is wide enough for one line; phones keep room for two */
    #status button { width: auto; margin: -0.75rem 0 -0.75rem -0.25rem; padding: 0.75rem 0.25rem; border: 0; background: none; color: var(--accent); font-size: var(--fs-sm); text-decoration: underline; }
  </style>
</Base>
