---
import { STRINGS, type Lang } from '../lib/i18n';

type Tab = 'times' | 'qibla' | 'calendar';
type Props = { title: string; description: string; tab: Tab; lang?: Lang };
const { title, description, tab, lang = 'id' } = Astro.props;
const t = STRINGS[lang];
const prefix = lang === 'id' ? '' : `/${lang}`;

// A visitor who chose English once lands on the English twin; the page stays hidden so Indonesian never flashes. English pages never redirect.
const REDIRECT = "try{if(localStorage.getItem('bedug:lang')==='en'){document.documentElement.style.visibility='hidden';location.replace('/en'+location.pathname+location.search+location.hash)}}catch(e){}";

// The same page in the other language, and every language's URL for the alternate links.
const other: Lang = lang === 'id' ? 'en' : 'id';
const idPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const pathIn = (l: Lang) => (l === 'id' ? idPath : `/en${idPath}`);

// Icons share one 24px grid and a 1.8 stroke.
const TABS: { id: Tab; href: string; icon: string }[] = [
  { id: 'times', href: '/', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>' },
  { id: 'qibla', href: '/kiblat/', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M15 9l-1.8 4.2L9 15l1.8-4.2z"/>' },
  { id: 'calendar', href: '/kalender/', icon: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v3.5M16 3v3.5"/>' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f32" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#143a2d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {(['id', 'en'] as Lang[]).map((l) => <link rel="alternate" hreflang={l} href={new URL(pathIn(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(idPath, Astro.site)} />
    {
      lang === 'id' && (
        <script is:inline set:html={REDIRECT} />
      )
    }
  </head>
  <body>
    <header class="panel">
      <div class="panel-inner">
        <p class="brand">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <mask id="brand-cut"><rect width="32" height="32" fill="#fff" /><circle cx="19.5" cy="12.5" r="8" /></mask>
            <circle cx="15" cy="17" r="10.5" fill="currentColor" mask="url(#brand-cut)" />
            <circle cx="23.5" cy="9" r="2.3" class="star" />
          </svg>
          Marbot
          <a class="lang" href={pathIn(other)} hreflang={other} lang={other} data-lang={other}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5s1.2-6.1 3.5-8.5z" /></svg>
            {t.otherLang}
          </a>
        </p>
        <slot name="header" />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <nav class="tabs" aria-label={t.menu}>
      {
        TABS.map((x) => (
          <a href={prefix + x.href} aria-current={x.id === tab ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.icon} />
            {t.tabs[x.id]}
          </a>
        ))
      }
    </nav>
    <script>
      // The link keeps the shared city (?kota=) and remembers the choice, so the next visit to the Indonesian address opens it.
      const link = document.querySelector<HTMLAnchorElement>('a.lang');
      link?.addEventListener('click', () => {
        link.search = location.search;
        // Indonesian removes the key: that needs no quota, so it sticks even when storage is full of month caches.
        try {
          if (link.dataset.lang === 'en') localStorage.setItem('bedug:lang', 'en');
          else localStorage.removeItem('bedug:lang');
        } catch {}
      });
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        // The cache serves the old version first; when a deploy's worker takes over, reload once to show it.
        // A first visit has no controller yet, so it never reloads.
        if (navigator.serviceWorker.controller) navigator.serviceWorker.addEventListener('controllerchange', () => location.reload(), { once: true });
      }
    </script>

    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f4f4f1;
        --card: #ffffff;
        --ink: #16201c;
        --muted: #5d6662;
        --faint: #6b7571; /* past rows: lighter than muted, still 4.5:1 on card */
        --line: #e6e6e1;
        --accent: #173f32;
        --on-accent: #ffffff;
        --accent-soft: #e6f0ea;
        --gold: #c8a24a;
        --panel: #173f32;
        --on-panel: #ffffff;
        --on-panel-muted: #b7dcc8;
        --kaaba: #121614;
        --scrim: #000000;
        --fs-xs: 0.75rem;
        --fs-sm: 0.875rem;
        --fs-md: 1rem;
        --fs-lg: 1.125rem;
        --fs-xl: 1.25rem;
        --fs-2xl: 1.5rem;
        --fs-display-sm: clamp(2.5rem, 12vw, 3rem);
        --fs-display: clamp(3rem, 15vw, 3.75rem);
        --r-sm: 0.65rem;
        --r-md: 0.75rem;
        --r-lg: 1rem;
        --r-xl: 1.75rem;
        --r-pill: 999px;
        --shadow: 0 1px 2px rgb(22 32 28 / 0.06), 0 2px 8px rgb(22 32 28 / 0.04);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1411;
          --card: #17201c;
          --ink: #f1f5f3;
          --muted: #b8c2bd;
          --faint: #9aa59f;
          --line: #34413a;
          --accent: #8fd1b1;
          --on-accent: #0d1411;
          --accent-soft: #1b3529;
          --gold: #d9b862;
          --panel: #143a2d;
          --on-panel-muted: #d2ecdf;
          --shadow: none;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-padding-bottom: calc(5rem + env(safe-area-inset-bottom)); scrollbar-color: var(--line) var(--bg); caret-color: var(--accent); accent-color: var(--accent); }
      ::selection { background: var(--accent-soft); color: var(--ink); }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 100%/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .panel {
        background: var(--panel);
        color: var(--on-panel);
        border-radius: 0 0 var(--r-xl) var(--r-xl);
        padding-top: env(safe-area-inset-top);
      }
      .panel ::selection { background: var(--on-panel); color: var(--panel); }
      .panel-inner { max-width: 28rem; margin: 0 auto; padding: 1rem 1.25rem 1.75rem; }
      .panel .brand { display: flex; align-items: center; gap: 0.4rem; margin: 0 0 1.5rem; font-size: var(--fs-sm); font-weight: 600; color: var(--on-panel-muted); }
      /* 44px to tap, but the overhang is pulled back so the row keeps the height it had. */
      .brand .lang { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; margin: -0.75rem -0.75rem -0.75rem auto; padding: 0 0.75rem; color: var(--on-panel-muted); text-decoration: none; text-underline-offset: 0.2em; }
      .brand .lang svg { width: 1rem; height: 1rem; color: inherit; fill: none; stroke: currentColor; stroke-width: 1.8; }
      @media (hover: hover) { .brand .lang:hover { color: var(--on-panel); text-decoration: underline; } }
      .brand svg { width: 1.25rem; height: 1.25rem; color: var(--on-panel); }
      .brand .star { fill: var(--gold); }
      .panel h1 { margin: 0; font-size: min(var(--fs-2xl), 11vw); line-height: 1.2; font-weight: 700; }
      .panel p { margin: 0; }
      /* The place name is the control: it opens the city picker, so it needs no separate button beside it. */
      .panel .city { display: inline-flex; align-items: center; gap: 0.2em; width: auto; min-height: 2.75rem; margin: -0.4rem -0.5rem; padding: 0 0.5rem; border: 0; border-radius: var(--r-md); background: transparent; color: inherit; font: inherit; text-align: start; }
      .city svg { flex: none; width: 0.85em; height: 0.85em; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
      @media (hover: hover) { .panel .city:hover { filter: none; background: color-mix(in srgb, var(--on-panel) 10%, transparent); } }
      .panel .city.from { margin-top: -0.1rem; color: var(--on-panel-muted); font-size: var(--fs-sm); font-weight: 600; }
      .city.from svg { width: 1.1em; height: 1.1em; opacity: 1; }
      main {
        max-width: 28rem;
        margin: 0 auto;
        padding: 1.25rem 1rem calc(6rem + env(safe-area-inset-bottom));
      }
      .card { background: var(--card); border-radius: var(--r-lg); box-shadow: var(--shadow); }
      .section-title { margin: 1.75rem 0.25rem 0.5rem; font-size: var(--fs-sm); font-weight: 600; color: var(--muted); }
      .tabs {
        position: fixed;
        inset: auto 0 0;
        display: flex;
        justify-content: center;
        background: var(--card);
        border-top: 1px solid var(--line);
        padding-bottom: env(safe-area-inset-bottom);
      }
      .tabs a {
        flex: 0 1 8rem;
        display: grid;
        justify-items: center;
        gap: 0.1rem;
        padding: 0.55rem 0 0.5rem;
        color: var(--muted);
        font-size: var(--fs-xs);
        text-decoration: none;
      }
      .tabs a[aria-current='page'] { color: var(--accent); font-weight: 600; }
      .tabs svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      @media (min-width: 40rem) {
        .panel { max-width: 26rem; margin: 1.5rem auto 0; border-radius: var(--r-xl); }
        .tabs { inset: auto 0 0; width: 26rem; margin: 0 auto; border: 1px solid var(--line); border-bottom: 0; border-radius: var(--r-lg) var(--r-lg) 0 0; box-shadow: var(--shadow); padding-bottom: 0; }
      }
      /* Wide screens: the panel and tabs share a left column, the page content fills the right. */
      @media (min-width: 60rem) {
        :root { --fs-display: 4.5rem; }
        body {
          display: grid;
          grid-template-columns: 24rem minmax(0, 36rem);
          grid-template-rows: auto 1fr;
          grid-template-areas: 'panel main' 'tabs main';
          justify-content: center;
          column-gap: 2rem;
        }
        .panel { grid-area: panel; max-width: none; margin: 1.5rem 0 0; }
        main { grid-area: main; max-width: none; margin: 0; padding: 1.5rem 0 2rem; }
        .tabs { grid-area: tabs; align-self: start; position: static; width: auto; margin: 1rem 0 0; border-bottom: 1px solid var(--line); border-radius: var(--r-lg); }
      }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      select, input, button {
        font: inherit;
        font-size: var(--fs-md);
        color: var(--ink);
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--r-md);
        padding: 0.65rem 0.75rem;
        min-height: 2.75rem;
        width: 100%;
      }
      input::placeholder { color: var(--muted); opacity: 1; }
      button { cursor: pointer; background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
      button.secondary { display: flex; justify-content: center; align-items: center; gap: 0.4rem; background: var(--card); border-color: var(--line); color: var(--ink); }
      button.secondary svg { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
      button.secondary .dot { fill: currentColor; stroke: none; }
      @media (hover: hover) { button:hover { filter: brightness(1.12); } }
      select:focus-visible, input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .panel button:focus-visible, .panel a:focus-visible { outline-color: var(--on-panel); }
      /* The painted pill stays small beside the text; the invisible ::after keeps the 44px tap target. */
      .pill {
        position: relative;
        width: auto;
        min-height: 2rem;
        padding: 0.25rem 0.875rem;
        border: 0;
        border-radius: var(--r-pill);
        background: color-mix(in srgb, var(--on-panel) 14%, transparent);
        color: var(--on-panel);
        font-size: var(--fs-sm);
        font-weight: 600;
      }
      .pill::after { content: ''; position: absolute; inset: -0.375rem 0; }
      .note { margin: 1.75rem 0.25rem 0; color: var(--muted); font-size: var(--fs-sm); text-wrap: pretty; }
    </style>
  </body>
</html>
