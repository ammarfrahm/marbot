---
import '@fontsource-variable/familjen-grotesk/wght.css';

type Tab = 'jadwal' | 'kiblat' | 'kalender';
type Props = { title: string; description: string; tab: Tab };
const { title, description, tab } = Astro.props;

// Icons share one 24px grid and a 1.8 stroke.
const TABS: { id: Tab; href: string; label: string; icon: string }[] = [
  { id: 'jadwal', href: '/', label: 'Jadwal', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>' },
  { id: 'kiblat', href: '/kiblat/', label: 'Kiblat', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M15 9l-1.8 4.2L9 15l1.8-4.2z"/>' },
  { id: 'kalender', href: '/kalender/', label: 'Kalender', icon: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v3.5M16 3v3.5"/>' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16110c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <main>
      <header>
        <p class="brand"><img src="/favicon.svg" alt="" width="20" height="20" />Marbot</p>
        <slot name="header" />
      </header>
      <slot />
    </main>
    <nav class="tabs" aria-label="Menu">
      {
        TABS.map((t) => (
          <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
            {t.label}
          </a>
        ))
      }
    </nav>
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>

    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f5efe4;
        --ink: #2b2118;
        --muted: #6b5e50;
        --line: #e2d7c5;
        --accent: #8f3f12;
        --accent-soft: #ead6c2;
        --skin: #efe2c8;
        --rim: #6f2e17;
        --peg: #9a5a37;
        --peg-on: #f2c46b;
        --skin-now: #f3d79a;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16110c;
          --ink: #f0e7d9;
          --muted: #a2927f;
          --line: #33291f;
          --accent: #e8955b;
          --accent-soft: #3a2616;
          --skin: #2a1f15;
          --rim: #5a2a16;
          --peg: #7a4a2c;
          --peg-on: #f0b660;
          --skin-now: #4a3216;
        }
      }
      * { box-sizing: border-box; }
      html { scrollbar-color: var(--line) var(--bg); caret-color: var(--accent); accent-color: var(--accent); }
      ::selection { background: var(--accent-soft); color: var(--ink); }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 16px/1.5 'Familjen Grotesk Variable', system-ui, sans-serif;
      }
      main {
        max-width: 28rem;
        margin: 0 auto;
        padding: 2rem 1rem calc(6rem + env(safe-area-inset-bottom));
      }
      .tabs {
        position: fixed;
        inset: auto 0 0;
        display: flex;
        justify-content: center;
        background: var(--bg);
        border-top: 1px solid var(--line);
        padding-bottom: env(safe-area-inset-bottom);
      }
      .tabs a {
        flex: 0 1 8rem;
        display: grid;
        justify-items: center;
        gap: 0.1rem;
        padding: 0.55rem 0 0.5rem;
        color: var(--muted);
        font-size: 0.8rem;
        text-decoration: none;
      }
      .tabs a[aria-current='page'] { color: var(--accent); font-weight: 650; }
      .tabs svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      select, button {
        font: inherit;
        font-size: 1rem;
        color: var(--ink);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        padding: 0.55rem 0.6rem;
        width: 100%;
      }
      button { cursor: pointer; border-color: var(--accent); color: var(--accent); }
      @media (hover: hover) { button:hover { background: var(--accent-soft); } }
      select:focus-visible, button:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .brand { display: flex; justify-content: center; align-items: center; gap: 0.4rem; margin: 0 0 0.75rem; font-weight: 650; color: var(--accent); }
      header { text-align: center; }
    </style>
  </body>
</html>
